extends ../layout.pug

block title
  title #{T('Edit %s', universe.title)}

block breadcrumbs
  if displayUniverse
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{universe.title}
  else
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{T('Home')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes`) #{T('Universes')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes/${universe.shortname}`) #{universe.title}
  |  / 
  span #{T('Edit')}

block append styles
  link(rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css")
  style.
    #cats td:not(:first-child) {
      padding: 0.125rem 0;
    }

    #cats td input:not([type='checkbox']) {
      border-radius: 0;
      border: none;
      width: 100%;
    }

    #cats .type-config td {
      padding: 0.5rem;
    }

    .sheet-layout-json {
      font-family: monospace;
      width: 100%;
      min-height: 12rem;
      box-sizing: border-box;
    }

block append save
  li#save-btn.navbarBtn
    script.
    a.navbarBtnLink.navbarText(onclick='document.forms.edit.requestSubmit()') #{T('Save Changes')}

block content
  script(src="https://unpkg.com/easymde/dist/easymde.min.js")
  script
    include /static/scripts/domUtils.js
    include /static/scripts/universes.js
    include /static/scripts/fetchUtils.js
    include /static/scripts/shortname.js

  .d-flex.justify-between.align-baseline
    h2 #{T('Edit %s', universe.title)}
    a.link.link-animated.color-error(href=`${ADDR_PREFIX}/universes/${universe.shortname}`) #{T('Discard Changes')}
  form#edit(method='POST')

    .inputGroup
      label(for='title') #{T('Title')}: 
      input#title(type='text' name='title' value=universe.title)

    .inputGroup
      label(for='shortname') #{T('Shortname')}: 
      input#shortname(type='text' name='shortname' value=universe.newShort)

    .inputGroup
      small(style={ 'grid-column': '2 / 4' })
        i
          b #{T('Warning')}: 
          | #{T('changing the shortname will kick out any users currently browsing the universe, ')}
          | #{T('any authors currently editing items will be unable to save their work, ')}
          | #{T('and any external bookmarks/links to the universe will break.')}
          | #{T('Make sure you know what you\'re doing!')}

    .inputGroup
      label(for='visibility') #{T('Visibility')}:
      select#visibility(name='visibility')
        option(value='public' selected=(universe.is_public)) #{T('Public')}
        option(value='private' selected=(!universe.is_public)) #{T('Private')}

    .inputGroup
      label(for='discussion_enabled') #{T('Discussion')}:
      select#discussion_enabled(name='discussion_enabled')
        option(value='enabled' selected=(universe.discussion_enabled)) #{T('Enabled')}
        option(value='disabled' selected=(!universe.discussion_enabled)) #{T('Disabled')}

    .inputGroup
      label(for='discussion_open') #{T('Who can comment')}:
      select#discussion_open(name='discussion_open')
        option(value='enabled' selected=(universe.discussion_open)) #{T('Anyone')}
        option(value='disabled' selected=(!universe.discussion_open)) #{T('Only with COMMENT permissions')}

    .inputGroup
      label #{T('Stories enabled')}:
      label.switch
        input#stories-enabled(type='checkbox' checked=Boolean(universe.obj_data.storiesEnabled))
        span.slider

    if universe.tier >= tiers.PREMIUM
      .inputGroup
        label #{T('Semantic search enabled')}:
        label.switch
          input#semantic-search-enabled(type='checkbox' checked=Boolean(universe.obj_data.semanticSearchEnabled))
          span.slider

      .inputGroup
        label #{T('Theme')}:
        select#theme
          option(value=null selected=(!universe.obj_data.theme)) #{T('None')}
          each _, themeKey in themes
            option(value=themeKey selected=(universe.obj_data.theme === themeKey)) #{T(`theme_${themeKey}`)}

      .inputGroup
        small(style={ 'grid-column': '2 / 4' })
          i
            | #{T('Note: selecting a theme from the list above will override the preferences of users visiting your universe.')}
            br
            | #{T('If this is not what you want to do, select "None".')}

      #customTheme.hidden.form-row-group
        .inputGroup
          label #{T('Use "Glass Pane" theme')}:
          label.switch
            input#glass(type='checkbox' checked=Boolean((universe.obj_data.customTheme || {}).glass))
            span.slider

        .inputGroup
          label #{T('Background Image URL')}:
          input#backgroundImage(type='text' value=(universe.obj_data.customTheme || {}).backgroundImage)

    #home-body.inputGroup
      label #{T('Home Page')}:
      .d-flex.align-center.gap-2
        label.switch
          input(type='checkbox' checked=(universe.obj_data.homePage && homePage !== null))
          span.slider
        button(type='submit' name='next' value=(`/editor/universes/${universe.shortname}/items/_home`) class={ hidden: !universe.obj_data.homePage || homePage === null }) #{T('Edit Home Page')}

    .inputGroup
      small(style={ 'grid-column': '2 / 4' })
        i #{T('This item will be shown in the "Home" tab of your universe page.')}

    #public-body.inputGroup
      label #{T('Public Page')}:
      .d-flex.align-center.gap-2
        label.switch
          input(type='checkbox' checked=(universe.obj_data.publicPage && publicPage !== null))
          span.slider
        button(type='submit' name='next' value=(`/editor/universes/${universe.shortname}/items/_public`) class={ hidden: !universe.obj_data.homePage || publicPage === null }) #{T('Edit Public Page')}

    .inputGroup
      small(style={ 'grid-column': '2 / 4' })
        i #{T('This item will be shown to users that don\'t have access to your universe instead of the "Access Denied" page.')}

    if universe.tier >= tiers.PREMIUM
      h3 #{T('MCP Access')}
      .mb-2
        small #{T('Allow LLM tools to read the selected parts of this universe through Archivium\'s MCP connector.')}

      .inputGroup
        label(for='mcp_items_enabled') #{T('Expose items')}:
        label.switch
          input#mcp_items_enabled(type='checkbox' name='mcp_items_enabled' checked=Boolean(universe.mcp_items_enabled))
          span.slider

      .inputGroup
        label(for='mcp_notes_enabled') #{T('Expose public notes')}:
        label.switch
          input#mcp_notes_enabled(type='checkbox' name='mcp_notes_enabled' checked=Boolean(universe.mcp_notes_enabled))
          span.slider

      .inputGroup
        label(for='mcp_discussions_enabled') #{T('Expose discussions')}:
        label.switch
          input#mcp_discussions_enabled(type='checkbox' name='mcp_discussions_enabled' checked=Boolean(universe.mcp_discussions_enabled))
          span.slider

    div
      input#obj_data(type='hidden' name='obj_data' value='{}')
      button(type='submit') #{T('Save Changes')}

    script.
      const storiesEnabled = document.querySelector('#stories-enabled');
      storiesEnabled.addEventListener('change', () => {
        updateObjData({ storiesEnabled: storiesEnabled.checked });
      });

    if universe.tier >= tiers.PREMIUM
      script.
        const semanticSearchEnabled = document.querySelector('#semantic-search-enabled');
        semanticSearchEnabled.addEventListener('change', () => {
          updateObjData({ semanticSearchEnabled: semanticSearchEnabled.checked });
        });

        const theme = document.querySelector('#theme');
        const glass = document.querySelector('#glass');
        const backgroundImage = document.querySelector('#backgroundImage');
        const customThemeDiv = document.querySelector('#customTheme');
        function handleThemeChange() {
          customThemeDiv.classList.toggle('hidden', theme.value !== 'custom');
          updateObjData({ theme: theme.value });
        }
        theme.addEventListener('change', handleThemeChange);
        glass.addEventListener('change', () => {
          updateObjData({ customTheme: {
            ...obj_data.customTheme ?? {},
            glass: glass.checked
          } });
        });
        backgroundImage.addEventListener('change', () => {
          updateObjData({ customTheme: {
            ...obj_data.customTheme ?? {},
            backgroundImage: backgroundImage.value
          } });
        });
        handleThemeChange();

    small.color-error.hidden#validation-error
    if error
      div
        span.text-small.color-error #{T(error)}

    h3 #{T('Item Types')}
    small
      b #{T('Note:')} 
      | #{T('be aware that removing or renaming item types will not update any existing items with that type.')}
    table.sheet
      thead
        tr
          th #{T('Shortname')}
          th #{T('Singular Type Name')}
          th #{T('Plural Type Name')}
          th #{T('Color')}
          th #{T('Tabs')}
          th
        tr
          td
          td.center
            small (e.g. "This is an 
              b item
              |  of #{universe.title}")
          td.center
            small (e.g. "These are 
              b items
              |  of #{universe.title}")
          td
          td.center
            small #{T('What new items start with')}
          td
      tbody#cats

    .d-flex.gap-2.mt-2
      button(type='button' onclick='addCat()') #{T('Add Type')}
      button(type='button' onclick='resetCats()') #{T('Reset to default types')}

    if universe.tier >= tiers.PREMIUM
      h3 #{T('Sheet Layouts')}
      .mb-2
        small #{T('Sheet layouts describe structured tabs, like character sheets. Attach one to an item type under "Tabs" above, and every item of that type gets a sheet tab.')}
      #sheet-layouts.d-flex.flex-col.gap-2
      .d-flex.gap-2.mt-2
        button(type='button' onclick='addLayout()') #{T('Add Layout')}

    .mt-2
      button(type='submit') #{T('Save Changes')}

  #data(data-universe=universe)
  script.
    updateObjData(JSON.parse(document.querySelector('#data').dataset.universe).obj_data);

    universe = '#{universe.shortname}';

    const homeBodyContainer = document.querySelector('#home-body');
    const publicBodyContainer = document.querySelector('#public-body');
    const visibilitySelect = document.querySelector('#visibility');
    visibilitySelect.addEventListener('change', () => {
      publicBodyContainer.classList.toggle('hidden', visibilitySelect.value !== 'private');
    });

    const homePageSwitch = homeBodyContainer.querySelector('.switch input');
    const homePageEdit = homeBodyContainer.querySelector('button');
    let homePageExists = #{homePage !== null};
    homePageSwitch.addEventListener('change', async () => {
      if (publicPageSwitch.checked && !publicPageExists) {
        await postJSON(`/api/universes/${universe}/items`, {
          skipValidation: true,
          title: T('Home Page'),
          shortname: '_home',
          item_type: '_special',
          obj_data: {},
        });
        homePageExists = true;
      }
      homePageEdit.classList.toggle('hidden', !homePageSwitch.checked);
      updateObjData({ homePage: homePageSwitch.checked });
    });

    const publicPageSwitch = publicBodyContainer.querySelector('.switch input');
    const publicPageEdit = publicBodyContainer.querySelector('button');
    let publicPageExists = #{publicPage !== null};
    publicPageSwitch.addEventListener('change', async () => {
      if (publicPageSwitch.checked && !publicPageExists) {
        await postJSON(`/api/universes/${universe}/items`, {
          skipValidation: true,
          title: T('Public Page'),
          shortname: '_public',
          item_type: '_special',
          obj_data: {},
        });
        publicPageExists = true;
      }
      publicPageEdit.classList.toggle('hidden', !publicPageSwitch.checked);
      updateObjData({ publicPage: publicPageSwitch.checked });
    });

    function toPlural(title) {
      // This function is very hacky and only works in english (and only sometimes), but it'll be good enough for most cases for now.
      return `${title}s`;
    }

    const sheetsEnabled = #{universe.tier >= tiers.PREMIUM};
    const DEFAULT_TAB_KINDS = [
      ['body', T('Main Text')],
      ['lineage', T('Lineage')],
      ['map', T('Map')],
      ['timeline', T('Timeline')],
      ['gallery', T('Gallery')],
    ];

    // Each entry is [shortname, title, titlePl, color, typeConfig].
    let catList;
    let openConfigs = new Set();
    function resetCatList() {
      catList = [];
      openConfigs = new Set();
      for (const catShortname in obj_data.cats) {
        catList.push([catShortname, ...obj_data.cats[catShortname], structuredClone((obj_data.typeConfigs ?? {})[catShortname] ?? {})]);
      }
    }

    // Sheet layouts are edited as JSON text; the server validates their structure on save.
    let layoutList = Object.values((obj_data.sheets ?? {}).layouts ?? {}).map(layout => JSON.stringify(layout, null, 2));
    function layoutIds() {
      const ids = [];
      for (const text of layoutList) {
        try {
          const { id } = JSON.parse(text);
          if (id && typeof id === 'string') ids.push(id);
        } catch {}
      }
      return ids;
    }

    function summarizeConfig(config) {
      const parts = [
        ...(config.defaultTabs ?? []).map(kind => (DEFAULT_TAB_KINDS.find(([k]) => k === kind) ?? [, kind])[1]),
        ...(config.customTabs ?? []),
        ...(config.sheet ? [T('Sheet: %s', config.sheet)] : []),
      ];
      return parts.length > 0 ? parts.join(', ') : T('None');
    }

    function createConfigRow(i) {
      const config = catList[i][4];
      const tabChecks = DEFAULT_TAB_KINDS.map(([kind, label]) => {
        const checkbox = createElement('input', { attrs: { type: 'checkbox', checked: (config.defaultTabs ?? []).includes(kind) } });
        checkbox.addEventListener('change', () => {
          // Keep the tabs in their canonical order.
          const selected = new Set(config.defaultTabs ?? []);
          if (checkbox.checked) selected.add(kind);
          else selected.delete(kind);
          config.defaultTabs = DEFAULT_TAB_KINDS.map(([k]) => k).filter(k => selected.has(k));
          if (config.defaultTabs.length === 0) delete config.defaultTabs;
        });
        return createElement('label', { classList: ['d-flex', 'align-center', 'gap-1'], children: [checkbox, createElement('span', { attrs: { innerText: label } })] });
      });

      const customInput = createElement('input', { attrs: {
        type: 'text',
        value: (config.customTabs ?? []).join(', '),
        placeholder: T('e.g. Stats, Inventory'),
      } });
      customInput.addEventListener('input', () => {
        const names = customInput.value.split(',').map(name => name.trim()).filter(Boolean);
        if (names.length > 0) config.customTabs = [...new Set(names)];
        else delete config.customTabs;
      });

      const rows = [
        createElement('div', { classList: ['d-flex', 'flex-wrap', 'gap-2', 'align-center'], children: [
          createElement('b', { attrs: { innerText: `${T('Default tabs')}:` } }),
          ...tabChecks,
        ] }),
        createElement('label', { classList: ['d-flex', 'gap-2', 'align-center'], children: [
          createElement('b', { attrs: { innerText: `${T('Custom data tabs')}:` } }),
          customInput,
        ] }),
      ];

      if (sheetsEnabled) {
        const ids = layoutIds();
        const sheetSelect = createElement('select', { children: [
          createElement('option', { attrs: { value: '', innerText: T('None'), selected: !config.sheet } }),
          ...ids.map(id => createElement('option', { attrs: { value: id, innerText: id, selected: config.sheet === id } })),
          // Keep a reference to a layout that's currently broken or being renamed, rather than silently dropping it.
          ...(config.sheet && !ids.includes(config.sheet) ? [createElement('option', { attrs: { value: config.sheet, innerText: T('%s (missing)', config.sheet), selected: true } })] : []),
        ] });
        sheetSelect.addEventListener('change', () => {
          if (sheetSelect.value) config.sheet = sheetSelect.value;
          else delete config.sheet;
        });
        rows.push(createElement('label', { classList: ['d-flex', 'gap-2', 'align-center'], children: [
          createElement('b', { attrs: { innerText: `${T('Sheet layout')}:` } }),
          sheetSelect,
        ] }));
      }

      rows.push(createElement('small', { children: [createElement('i', { attrs: {
        innerText: T('Only affects newly created items. Existing items can add missing tabs from the editor.'),
      } })] }));

      return createElement('tr', { classList: ['type-config'], children: [
        createElement('td', { attrs: { colSpan: 6 }, children: [createElement('div', { classList: ['d-flex', 'flex-col', 'gap-1'], children: rows })] }),
      ] });
    }

    function updateCats() {
      const catsTable = document.getElementById('cats');
      catsTable.innerHTML = '';
      for (let i = 0; i < catList.length; i++) {
        const [catShortname, catTitle, catTitlePl, catColor] = catList[i];

        const titlePlInput = createElement('input', { dataset: { name: 'titlePl' }, attrs: { value: catTitlePl } });
        titlePlInput.addEventListener('input', () => {
          catList[i][2] = titlePlInput.value;
        });

        const titleInput = createElement('input', { dataset: { name: 'title' }, attrs: { value: catTitle } });
        titleInput.addEventListener('input', () => {
          if (toPlural(catList[i][1]) === titlePlInput.value || !titlePlInput.value) {
            titlePlInput.value = toPlural(titleInput.value);
            catList[i][2] = titlePlInput.value;
          }
          catList[i][1] = titleInput.value;
        });
        titleInput.addEventListener('change', () => {
          if (!catList[i][0]) {
            catList[i][0] = toShortname(titleInput.value);
            updateCats();
          }
        });

        const colorInput = createElement('input', {
          dataset: { name: 'color' },
          attrs: { id: `color${i}`, value: catColor, type: 'color', style: 'padding: 0; min-width: 3rem;' }
        });
        colorInput.addEventListener('input', () => catList[i][3] = colorInput.value);

        const catRow = createElement('tr', { children: [
          createElement('td', { dataset: { name: 'shortname' }, attrs: { innerText: catShortname } }),
          createElement('td', { children: [titleInput] }),
          createElement('td', { children: [titlePlInput] }),
          createElement('td', { children: [createElement('div', { classList: ['d-flex'], children: [colorInput] })] }),
          createElement('td', { children: [createElement('button', { attrs: {
            type: 'button',
            title: summarizeConfig(catList[i][4]),
            innerText: openConfigs.has(i) ? T('Done') : T('Configure'),
            onclick: () => {
              if (openConfigs.has(i)) openConfigs.delete(i);
              else openConfigs.add(i);
              updateCats();
            },
          } })] }),
          createElement('td', { children: [createElement('button', { attrs: {
            innerText: T('Remove'),
            onclick: (e) => {
              e.preventDefault();
              catList.splice(i, 1);
              openConfigs = new Set([...openConfigs].filter(j => j !== i).map(j => j > i ? j - 1 : j));
              updateCats();
            },
          } })] }),
        ] });
        catsTable.appendChild(catRow);
        if (openConfigs.has(i)) catsTable.appendChild(createConfigRow(i));
      }
    }

    function addCat() {
      catList.push(['', '', '', '#ffffff', {}]);
      updateCats();
    }

    const NEW_LAYOUT = {
      version: 1,
      id: 'new-sheet',
      title: 'Sheet',
      root: 'sheet',
      rows: [{ sections: [{ title: 'Overview', fields: [{ widget: 'title' }, { widget: 'text', path: 'summary', label: 'Summary', multiline: true }] }] }],
    };

    function updateLayouts() {
      const container = document.getElementById('sheet-layouts');
      if (!container) return;
      container.innerHTML = '';
      layoutList.forEach((text, i) => {
        const error = createElement('small', { classList: ['color-error'] });
        const textarea = createElement('textarea', { classList: ['sheet-layout-json'], attrs: { value: text, spellcheck: false } });
        const checkJson = () => {
          try {
            JSON.parse(textarea.value);
            error.innerText = '';
          } catch (err) {
            error.innerText = T('Invalid JSON: %s', err.message);
          }
        };
        textarea.addEventListener('input', () => layoutList[i] = textarea.value);
        // Layout ids feed the per-type sheet selects, so refresh those once an edit is done.
        textarea.addEventListener('change', () => {
          checkJson();
          updateCats();
        });
        checkJson();
        container.appendChild(createElement('div', { classList: ['sheet', 'd-flex', 'flex-col', 'gap-1'], children: [
          textarea,
          error,
          createElement('div', { children: [createElement('button', { attrs: {
            type: 'button',
            innerText: T('Remove'),
            onclick: () => {
              // Detach the layout from any item types using it.
              let removedId;
              try {
                removedId = JSON.parse(layoutList[i]).id;
              } catch {}
              for (const cat of catList) {
                if (removedId && cat[4].sheet === removedId) delete cat[4].sheet;
              }
              layoutList.splice(i, 1);
              updateLayouts();
              updateCats();
            },
          } })] }),
        ] }));
      });
    }

    function addLayout() {
      const ids = layoutIds();
      let id = NEW_LAYOUT.id;
      for (let n = 2; ids.includes(id); n++) id = `${NEW_LAYOUT.id}-${n}`;
      layoutList.push(JSON.stringify({ ...NEW_LAYOUT, id }, null, 2));
      updateLayouts();
      updateCats();
    }
    window.addLayout = addLayout;

    function resetCats() {
      setDefaultCats();
      resetCatList();
      updateCats();
    }

    window.addCat = addCat;
    window.resetCats = resetCats;

    if (!('cats' in obj_data)) setDefaultCats();
    resetCatList();
    updateCats();
    updateLayouts();

    document.forms.edit.addEventListener('submit', (e) => {
      const formError = document.querySelector('#validation-error');
      formError.classList.add('hidden');

      const showError = (message) => {
        formError.innerText = message;
        formError.classList.remove('hidden');
        e.preventDefault();
      };

      const newCats = {};
      const newTypeConfigs = {};
      for (let i = 0; i < catList.length; i++) {
        let [catShortname, catTitle, catTitlePl, catColor, catConfig] = catList[i];

        if (!catTitle) {
          // Title is missing, error
          formError.innerText = T('Make sure the name fields for all item types are filled out, or remove unwanted ones!');
          formError.classList.remove('hidden');
          return e.preventDefault();
        }

        if (!catShortname) {
          // Shortname is missing, autofill it
          catShortname = toShortname(catTitle);
        }

        if (!catTitlePl) {
          // Title plural is missing, autofill it
          catTitlePl = toPlural(catTitle);
        }

        newCats[catShortname] = [catTitle.trim(), catTitlePl.trim(), catColor];
        if (catConfig && Object.keys(catConfig).length > 0) newTypeConfigs[catShortname] = catConfig;
      }

      const newObjData = { cats: newCats, typeConfigs: newTypeConfigs };
      if (sheetsEnabled) {
        const layouts = {};
        for (const text of layoutList) {
          let layout;
          try {
            layout = JSON.parse(text);
          } catch (err) {
            return showError(T('A sheet layout is not valid JSON: %s', err.message));
          }
          if (!layout || typeof layout.id !== 'string' || !layout.id) return showError(T('Every sheet layout needs an "id".'));
          if (layout.id in layouts) return showError(T('Two sheet layouts have the id "%s".', layout.id));
          layouts[layout.id] = layout;
        }
        newObjData.sheets = { ...obj_data.sheets ?? {}, layouts };
      }
      updateObjData(newObjData);
    });
