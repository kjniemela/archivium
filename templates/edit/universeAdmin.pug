extends ../layout.pug

block title
  title #{T('Admin Menu')} — #{T('Archivium')}

block breadcrumbs
  if displayUniverse
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{universe.title}
  else
    a.link.link-animated(href=`${ADDR_PREFIX}/`) #{T('Home')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes`) #{T('Universes')}
    |  / 
    a.link.link-animated(href=`${ADDR_PREFIX}/universes/${universe.shortname}`) #{universe.title}
  |  / 
  span #{T('Admin Menu')}

block scripts
  script
    include /static/scripts/tabs.js
    include /static/scripts/fetchUtils.js
    include /static/scripts/shortname.js
  script.
    const formatDate = !{formatDate};
    const validateUsername = !{validateUsername};

block content
  .d-flex.justify-between.align-baseline
    h2 #{universe.title} Admin Menu
    a.link.link-animated(href=`${ADDR_PREFIX}/universes/${universe.shortname}`) #{T('Go back')}

  ul#tabBtns.navbarBtns.gap-1.mb-2.scroll-x
    li.navbarBtn(data-tab='permissions')
      h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('permissions')`) #{T('Permissions')}
    li.navbarBtn(data-tab='vaults')
      h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('vaults')`) #{T('Vaults')}
    li.navbarBtn(data-tab='storage')
      h3.navbarBtnLink.navbarText.ma-0(onclick=`showTab('storage')`) #{T('Storage')}

  .tabs
    .itemTab.hidden.flex-col(data-tab='permissions')
      script.
        window.addEventListener('load', () => {
          document.querySelectorAll('form .permission_level').forEach((select) => {
            select.onchange = async () => {
              console.log(select, select.value)
              const [response] = await putJSON('/api/universes/#{universe.shortname}/perms', { username: select.form.username.value, permissionLevel: Number(select.value) });
              if (response.status !== 200) {
                select.value = select.form.init.value;
              } else {
                window.location.reload();
              }
            }
          });

          document.querySelectorAll('form #invite_user').forEach((input) => {
            const form = input.form;
            form.onsubmit = async (e) => {
              e.preventDefault();
              await putJSON(`/api/universes/#{universe.shortname}/invite/${form.username.value}`, { permissionLevel: Number(form.new_permission_level.value) });
              window.location.reload();
            }
          });
        });

      .d-flex.flex-col.align-start
        - const permLevels = Object.keys(perms).filter((item) => !isNaN(Number(item))).map(Number).sort((a, b) => b - a);
        each level in permLevels
          - const authorIds = Object.keys(universe.author_permissions).filter((authorId) => universe.author_permissions[authorId] === level);
          if authorIds.length
            .d-flex.align-baseline.gap-1.mt-2
              h2.ma-0 #{T(`perms_${level}`)} (#{authorIds.length})
            .grid(style={ 'grid-template-columns': '1fr 1rem 1fr' })
              each authorId in authorIds
                - const perm = level;
                form.grid.grid-inherit.align-center(style={ 'grid-column': '1 / 4' })
                  input(class='username' name='username' type='hidden' value=universe.authors[authorId])
                  input(class='init' name='init' type='hidden' value=perm)
                  b(style={ 'grid-column': '1 / 2' }) #{universe.authors[authorId]}
                  select(class='permission_level' name='permission_level' style={ 'grid-column': '3 / 4' } disabled=((perm === perms.OWNER && ownerCount === 1) || (perm > universe.author_permissions[contextUser.id])))
                    each permission_level in Object.keys(perms).filter((item) => !isNaN(Number(item)))
                      option(value=permission_level selected=(permission_level == perm) disabled=(permission_level > universe.author_permissions[contextUser.id])) #{T(`perms_${permission_level}`)}

      br

      form
        .d-flex
          input(id='username' name='username' placeholder=T('Username'))
          select(id='new_permission_level' name='new_permission_level' style={ 'grid-column': '3 / 4' } disabled=((perm === perms.OWNER && ownerCount === 1) || (perm > universe.author_permissions[contextUser.id])))
            each permission_level in Object.keys(perms).filter((item) => !isNaN(Number(item)))
              if permission_level > (universe.is_public ? (universe.discussion_open ? perms.COMMENT : perms.READ) : perms.NONE)
                option(value=permission_level selected=(permission_level == perms.READ) disabled=(permission_level > universe.author_permissions[contextUser.id])) #{T(`perms_${permission_level}`)}
          button(type='submit' id='invite_user') #{T('Invite User')}

      br

      #invites.d-flex.flex-col.gap-2
        each invite in invites
          .d-flex.nowrap.gap-1.align-center(data-user=invite.username)
            span
              a.link.link-animated(href=`${ADDR_PREFIX}/users/${invite.username}`) #{invite.username}
              |  was invited with 
              b #{T(`perms_${invite.permission_level}`).toLowerCase()}
              |  permissions.
            button(
              onclick=`deleteJSON(
                '/api/universes/${universe.shortname}/invite/${invite.username}'
              ).then(() => window.location.reload())`
            ) #{T('Cancel')}

      br
      hr
      br

      #requests.d-flex.flex-col.gap-2
        each request in requests
          .d-flex.nowrap.gap-1.align-center
            span
              a.link.link-animated(href=`${ADDR_PREFIX}/users/${request.username}`) #{request.username}
              |  is requesting 
              b #{T(`perms_${request.permission_level}`).toLowerCase()}
              |  permissions.
            button(
              onclick=`putJSON(
                '/api/universes/${universe.shortname}/perms', { username: '${request.username}', permissionLevel: ${request.permission_level} }
              ).then(() => window.location.reload())`
            ) #{T('Approve')}
            button(
              onclick=`deleteJSON(
                '/api/universes/${universe.shortname}/request/${request.username}'
              ).then(() => window.location.reload())`
            ) #{T('Deny')}

    .itemTab.hidden.flex-col(data-tab='vaults')
      script.
        window.addEventListener('load', () => {
          document.querySelectorAll('form .vault_permission_level').forEach((select) => {
            select.onchange = async () => {
              const vaultShortname = select.form.dataset.vault;
              const [response] = await putJSON(`/api/universes/#{universe.shortname}/vaults/${vaultShortname}/perms`, { username: select.form.username.value, permissionLevel: Number(select.value) });
              if (response.status !== 200) {
                select.value = select.form.init.value;
              } else {
                window.location.reload();
              }
            }
          });

          document.querySelectorAll('form.vault_invite').forEach((form) => {
            form.onsubmit = async (e) => {
              e.preventDefault();
              const vaultShortname = form.dataset.vault;
              const [response] = await putJSON(`/api/universes/#{universe.shortname}/vaults/${vaultShortname}/perms`, { username: form.username.value, permissionLevel: Number(form.new_permission_level.value) });
              if (response.status === 200) window.location.reload();
            }
          });

          const createVaultForm = document.querySelector('#create_vault');
          if (createVaultForm) {
            let hasEditedVaultShortname = false;
            createVaultForm.title.addEventListener('input', () => {
              if (!hasEditedVaultShortname) createVaultForm.shortname.value = toShortname(createVaultForm.title.value);
            });
            createVaultForm.shortname.addEventListener('input', () => {
              hasEditedVaultShortname = true;
            });
            createVaultForm.onsubmit = async (e) => {
              e.preventDefault();
              await postJSON(`/api/universes/#{universe.shortname}/vaults`, {
                title: createVaultForm.title.value,
                shortname: createVaultForm.shortname.value,
              });
              window.location.reload();
            }
          }

          document.querySelectorAll('.delete_vault').forEach((button) => {
            button.onclick = async () => {
              const [response] = await deleteJSON(`/api/universes/#{universe.shortname}/vaults/${button.dataset.vault}`);
              if (response.status === 200) window.location.reload();
            }
          });
        });

      each vault in vaults
        .d-flex.flex-col.gap-1.mb-2(style={ border: '1px solid var(--color-border)', padding: '0.5rem' })
          .d-flex.justify-between.align-center
            h2.ma-0 #{vault.title}
            if vault.requester_permissions >= perms.OWNER
              button.delete_vault(data-vault=vault.shortname) #{T('Delete Vault')}

          - const vaultPermLevels = Object.keys(perms).filter((item) => !isNaN(Number(item))).map(Number).sort((a, b) => b - a);
          - const inheritedOwnerIds = Object.keys(universe.author_permissions).filter((authorId) => universe.author_permissions[authorId] === perms.OWNER);
          each level in vaultPermLevels
            - const explicitIds = Object.keys(vault.author_permissions).filter((authorId) => vault.author_permissions[authorId] === level && !inheritedOwnerIds.includes(authorId));
            - const authorRows = explicitIds.map((authorId) => ({ username: vault.authors[authorId], inherited: false })).concat(level === perms.OWNER ? inheritedOwnerIds.map((authorId) => ({ username: universe.authors[authorId], inherited: true })) : []);
            if authorRows.length
              .d-flex.align-baseline.gap-1.mt-1
                b #{T(`perms_${level}`)} (#{authorRows.length})
              .grid.align-self-start(style={ 'grid-template-columns': '1fr 1rem 1fr' })
                each author in authorRows
                  - const perm = level;
                  form.grid.grid-inherit.align-center(style={ 'grid-column': '1 / 4' } data-vault=vault.shortname)
                    input(class='username' name='username' type='hidden' value=author.username)
                    input(class='init' name='init' type='hidden' value=perm)
                    span(style={ 'grid-column': '1 / 2' })
                      | #{author.username}
                      if author.inherited
                        span.text-small= ` (${T('universe owner')})`
                    select(class='vault_permission_level' name='permission_level' style={ 'grid-column': '3 / 4' } disabled=(author.inherited || perm > vault.requester_permissions))
                      each permission_level in Object.keys(perms).filter((item) => !isNaN(Number(item)))
                        option(value=permission_level selected=(permission_level == perm) disabled=(permission_level > vault.requester_permissions)) #{T(`perms_${permission_level}`)}

          form.vault_invite(data-vault=vault.shortname)
            .d-flex.mt-1
              input(name='username' placeholder=T('Username'))
              select(name='new_permission_level')
                each permission_level in Object.keys(perms).filter((item) => !isNaN(Number(item)) && Number(item) > perms.NONE)
                  option(value=permission_level selected=(permission_level == perms.READ) disabled=(permission_level > vault.requester_permissions)) #{T(`perms_${permission_level}`)}
              button(type='submit') #{T('Add User')}

        hr

      br
      h2 #{T('Create Vault')}
      form#create_vault
        .d-flex
          input(name='title' placeholder=T('Title'))
          input(name='shortname' placeholder=T('Shortname'))
          button(type='submit') #{T('Create Vault')}

    .itemTab.hidden.flex-col(data-tab='storage')
      h2 #{T('Images')}
      ul
        li
          b #{T('Images Stored')}:
          |  #{formatBytes(totalStoredImages)} / #{formatBytes(tierLimits.images)}

      if universe.tier >= tiers.PREMIUM || embeddingStats.chunkCount > 0
        h2 #{T('Semantic Search')}
        ul
          li
            b #{T('Embedded Chunks')}:
            |  #{embeddingStats.chunkCount}
          li
            b #{T('Items With Embedded Content')}:
            |  #{embeddingStats.itemCount}
          li
            b #{T('Estimated Vector Storage')}:
            |  ~#{formatBytes(embeddingStats.estimatedBytes)}
