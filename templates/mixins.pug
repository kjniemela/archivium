mixin linkList(links)
  -
    let i = 0;
  span
    each link in links
      -
        let suff;
        if (i === links.length - 1) suff = '';
        else if (i === links.length - 2) suff = links.length === 2 ? ' and ' : ', and ';
        else suff = ', ';
      a.link.link-animated(href=link[1])= link[0]
      | #{suff}
      - i++;

mixin authorList(authors, author_permissions)
  -
    const authorsList = Object
      .keys(authors)
      .filter(key => author_permissions[key] >= perms.WRITE)
      .sort((a, b) => author_permissions[a] > author_permissions[b] ? -1 : 1)
      .map(key => [authors[key], `/users/${authors[key]}`]);
  +linkList(authorsList)

mixin highlight(string, keyword, italics)
  -
    const regex = new RegExp(`(${keyword})`, 'gi');
    const segments = string.split(regex);
  span
    each segment, idx in segments
      if segment.toLowerCase() === keyword.toLowerCase()
        if italics
          i #{segment}
        else
          b #{segment}
      else
        | #{segment}

mixin userIcon(user)
  .d-flex
    .badge-anchor.mb-auto
      img.userIcon(alt=user.username, src=user.pfpUrl)
      if user.plan == plans.BETA || user.plan == plans.PREMIUM_BETA
        .badge.user-badge
          span.material-symbols-outlined experiment
          b #{T('Beta Tester')}
      if user.plan == plans.SUPER
        .badge.user-badge
          span.material-symbols-outlined security
          b #{T('Site Admin')}

mixin themeSwatches(selectId)
  style.
    .theme-swatches { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; justify-content: center; }
    .theme-swatch {
      display: flex; flex-direction: column; gap: 0.25rem; width: 5.75rem; padding: 0.25rem;
      font-size: 0.75rem; text-align: center; cursor: pointer;
    }
    .theme-swatch[aria-pressed="true"] { outline: 0.125rem solid var(--link-color); outline-offset: 0.0625rem; }
    .theme-swatch-preview {
      display: flex; flex-direction: column; justify-content: center; gap: 0.25rem; height: 3rem; padding: 0.25rem;
      border: 0.0625rem solid var(--input-border-color); border-radius: 0.25rem; background-size: cover;
    }
    .theme-swatch-preview i { display: block; height: 0.375rem; border-radius: 0.1875rem; }
  .theme-swatches(data-select=selectId data-var-names=JSON.stringify(THEME_VAR_NAMES))
    each theme, key in themes
      if key !== 'custom'
        - const p = themePreview(theme);
        button.theme-swatch(type='button' data-theme=key data-attrs=JSON.stringify(themeAttrs(theme)) aria-pressed='false' title=T(`theme_${key}`))
          .theme-swatch-preview(style=`background: ${p.background || p.page}; background-color: ${p.page};`)
            i(style=`background: ${p.sheet}; width: 100%;`)
            i(style=`background: ${p.link}; width: 60%;`)
            if p.accent
              i(style=`background: ${p.accent}; width: 40%;`)
            i(style=`background: ${p.text}; width: 80%;`)
          span #{T(`theme_${key}`)}
      else
        button.theme-swatch(type='button' data-theme=key aria-pressed='false' title=T(`theme_${key}`))
          .theme-swatch-preview
            p(style='font-size: 1.875rem;') ?
          span #{T(`theme_${key}`)}

  script.
    (() => {
      const box = document.currentScript.previousElementSibling;
      const select = document.getElementById(box.dataset.select);
      const root = document.documentElement;
      const varNames = JSON.parse(box.dataset.varNames);
      const sync = () => box.querySelectorAll('.theme-swatch').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.theme === select.value)));

      function applyTheme({ classes, vars }) {
        for (const cls of [...root.classList]) {
          if (cls === 'palette' || cls === 'palette-accent' || cls.startsWith('theme-')) root.classList.remove(cls);
        }
        root.classList.add(...classes);
        varNames.forEach(name => root.style.removeProperty(name));
        Object.entries(vars).forEach(([name, value]) => root.style.setProperty(name, value));
        const glassPane = document.getElementById('glassPane');
        if (glassPane) glassPane.classList.toggle('glass-pane', classes.includes('theme-glass'));
      }

      function customAttrs() {
        const classes = [];
        const vars = {};
        if (document.getElementById('glass')?.checked) classes.push('theme-glass');
        const image = document.getElementById('backgroundImage')?.value.trim();
        if (image) {
          classes.push('theme-bg-image');
          vars['--theme-background-image'] = `url("${image.replace(/["\\\n]/g, encodeURIComponent)}")`;
        }
        const palette = document.getElementById('paletteEditor')?.readPalette();
        if (palette) {
          classes.push('palette');
          for (const key of Object.keys(palette.light)) {
            vars[`--${key}-color`] = `light-dark(${palette.light[key]}, ${palette.dark[key]})`;
          }
          if (palette.light.accent) classes.push('palette-accent');
          vars['color-scheme'] = 'light dark';
        }
        return { classes, vars };
      }

      function preview() {
        const btn = box.querySelector(`.theme-swatch[data-theme="${select.value}"]`);
        if (!btn) return;
        applyTheme(btn.dataset.attrs ? JSON.parse(btn.dataset.attrs) : customAttrs());
      }

      box.addEventListener('click', (e) => {
        const btn = e.target.closest('.theme-swatch');
        if (!btn) return;
        select.value = btn.dataset.theme;
        select.dispatchEvent(new Event('change'));
      });
      select.addEventListener('change', () => { sync(); preview(); });
      // Keep the preview up to date while editing the custom theme.
      document.addEventListener('change', (e) => {
        if (select.value === 'custom' && e.target.closest('#customTheme, #paletteEditor')) preview();
      });
      sync();
    })();

mixin paletteRow(palette, key, label)
  - const paletteDefaults = { light: { page: '#e9e9e9', sheet: '#fefefe', text: '#000000', link: '#006699', accent: '#006699' }, dark: { page: '#444444', sheet: '#333333', text: '#f5f5f5', link: '#46b9f2', accent: '#46b9f2' } };
  .inputGroup
    label #{label}:
    .palette-pair
      each mode in ['light', 'dark']
        input(type='color' data-palette-mode=mode data-palette-key=key title=T(mode === 'light' ? 'Light' : 'Dark') aria-label=`${label} (${mode})` value=((palette[mode] || {})[key] || paletteDefaults[mode][key]))

mixin paletteEditor(savedPalette)
  - const palette = savedPalette || {};
  #paletteEditor
    .inputGroup
      label #{T('Use custom color palette')}:
      label.switch
        input#usePalette(type='checkbox' checked=Boolean(palette.light || palette.dark))
        span.slider

    #paletteFields.hidden(style='display: grid; gap: inherit;')
      .inputGroup
        span
        .palette-pair
          strong #{T('Light')}
          strong #{T('Dark')}
      +paletteRow(palette, 'page', T('Page Color'))
      +paletteRow(palette, 'sheet', T('Sheet Color'))
      +paletteRow(palette, 'text', T('Text Color'))
      +paletteRow(palette, 'link', T('Link Color'))
      .inputGroup
        label #{T('Use accent color')}:
        label.switch
          input#useAccent(type='checkbox' checked=Boolean((palette.light || {}).accent || (palette.dark || {}).accent))
          span.slider
      #accentRow.hidden
        +paletteRow(palette, 'accent', T('Accent Color'))
  script.
    (() => {
      const editor = document.getElementById('paletteEditor');
      const usePalette = editor.querySelector('#usePalette');
      const useAccent = editor.querySelector('#useAccent');
      const sync = () => {
        editor.querySelector('#paletteFields').classList.toggle('hidden', !usePalette.checked);
        editor.querySelector('#accentRow').classList.toggle('hidden', !useAccent.checked);
      };
      editor.readPalette = () => {
        if (!usePalette.checked) return undefined;
        const result = { light: {}, dark: {} };
        for (const input of editor.querySelectorAll('input[type=color]')) {
          if (input.dataset.paletteKey === 'accent' && !useAccent.checked) continue;
          result[input.dataset.paletteMode][input.dataset.paletteKey] = input.value;
        }
        return result;
      };
      editor.addEventListener('change', () => {
        sync();
        editor.dispatchEvent(new CustomEvent('palettechange', { bubbles: true }));
      });
      sync();
    })();
