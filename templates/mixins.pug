mixin linkList(links)
  -
    let i = 0;
  span
    each link in links
      -
        let suff;
        if (i === links.length - 1) suff = '';
        else if (i === links.length - 2) suff = links.length === 2 ? ' and ' : ', and ';
        else suff = ', ';
      a.link.link-animated(href=link[1])= link[0]
      | #{suff}
      - i++;

mixin authorList(authors, author_permissions)
  -
    const authorsList = Object
      .keys(authors)
      .filter(key => author_permissions[key] >= perms.WRITE)
      .sort((a, b) => author_permissions[a] > author_permissions[b] ? -1 : 1)
      .map(key => [authors[key], `/users/${authors[key]}`]);
  +linkList(authorsList)

mixin highlight(string, keyword, italics)
  -
    const regex = new RegExp(`(${keyword})`, 'gi');
    const segments = string.split(regex);
  span
    each segment, idx in segments
      if segment.toLowerCase() === keyword.toLowerCase()
        if italics
          i #{segment}
        else
          b #{segment}
      else
        | #{segment}

mixin userIcon(user)
  .d-flex
    .badge-anchor.mb-auto
      img.userIcon(alt=user.username, src=user.pfpUrl)
      if user.plan == plans.BETA || user.plan == plans.PREMIUM_BETA
        .badge.user-badge
          span.material-symbols-outlined experiment
          b #{T('Beta Tester')}
      if user.plan == plans.SUPER
        .badge.user-badge
          span.material-symbols-outlined security
          b #{T('Site Admin')}

mixin themeSwatches(selectId)
  style.
    .theme-swatches { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; justify-content: center; }
    .theme-swatch {
      display: flex; flex-direction: column; gap: 0.25rem; width: 5.75rem; padding: 0.25rem;
      font-size: 0.75rem; text-align: center; cursor: pointer;
    }
    .theme-swatch[aria-pressed="true"] { outline: 0.125rem solid var(--link-color); outline-offset: 0.0625rem; }
    .theme-swatch-preview {
      display: flex; flex-direction: column; justify-content: center; gap: 0.25rem; height: 3rem; padding: 0.25rem;
      border: 0.0625rem solid var(--input-border-color); border-radius: 0.25rem; background-size: cover;
    }
    .theme-swatch-preview i { display: block; height: 0.375rem; border-radius: 0.1875rem; }
  .theme-swatches(data-select=selectId)
    each theme, key in themes
      if key !== 'custom'
        - const p = themePreview(theme);
        button.theme-swatch(type='button' data-theme=key aria-pressed='false' title=T(`theme_${key}`))
          .theme-swatch-preview(style=`background: ${p.background || p.page}; background-color: ${p.page};`)
            i(style=`background: ${p.sheet}; width: 100%;`)
            i(style=`background: ${p.link}; width: 60%;`)
            if p.accent
              i(style=`background: ${p.accent}; width: 40%;`)
            i(style=`background: ${p.text}; width: 80%;`)
          span #{T(`theme_${key}`)}
      else
        button.theme-swatch(type='button' data-theme=key aria-pressed='false' title=T(`theme_${key}`))
          .theme-swatch-preview
            p(style='font-size: 1.875rem;') ?
          span #{T(`theme_${key}`)}

  script.
    (() => {
      const box = document.currentScript.previousElementSibling;
      const select = document.getElementById(box.dataset.select);
      const sync = () => box.querySelectorAll('.theme-swatch').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.theme === select.value)));
      box.addEventListener('click', (e) => {
        const btn = e.target.closest('.theme-swatch');
        if (!btn) return;
        select.value = btn.dataset.theme;
        select.dispatchEvent(new Event('change'));
      });
      select.addEventListener('change', sync);
      sync();
    })();
