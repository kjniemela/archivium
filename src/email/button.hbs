<table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:18px auto {{#if padBottom}}{{padBottom}}{{else}}16px{{/if}};">
  <tr>
    <td align="center" bgcolor="#006699" style="border-radius:6px;background-color:#006699;">
      <a href="{{href}}" target="_blank" style="display:inline-block;padding:10px 25px;font-family:Montserrat,sans-serif;font-size:16px;font-weight:bold;line-height:1.5;color:#fefefe;text-decoration:none;border-radius:6px;">{{label}}</a>
    </td>
  </tr>
</table>
